<mxfile host="app.diagrams.net"><diagram name="social-login-flow"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" pageWidth="1240" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="가입·로그인 흐름: 구글·카카오 소셜 로그인 (B2C)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#1a1a1a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="450.0" height="26" as="geometry"/></mxCell><mxCell id="c4" value="2026-11-03 · 근거: docs/decisions.md &quot;소셜 로그인&quot;, docs/product/research.md 7절" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="648.0" height="18" as="geometry"/></mxCell><mxCell id="c5" value="첫 화면 /&lt;br&gt;[구글로 시작]  [카카오로 시작]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="95" width="300" height="60" as="geometry"/></mxCell><mxCell id="c6" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#333333;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="155" as="sourcePoint"/><mxPoint x="400" y="190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c7" value="구글 · 카카오 로그인 화면&lt;br&gt;동의: 이름 · 이메일&lt;br&gt;(카카오는 이메일 동의 필수)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="190" width="300" height="70" as="geometry"/></mxCell><mxCell id="c8" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#333333;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="260" as="sourcePoint"/><mxPoint x="400" y="295" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c9" value="Backend가 제공자에게서 받음&lt;br&gt;고유 ID(구글 sub · 카카오 회원번호)&lt;br&