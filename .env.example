# 이 파일을 복사해 저장소 루트에 .env를 만들고 값을 채운다. 실제 값은 이 파일에 쓰지 않는다.
# DB_URL은 로컬 실행·테스트용이다(Compose DB는 호스트 5433). 예: jdbc:postgresql://localhost:5433/<DB_NAME>
# Compose의 backend 컨테이너에서는 DB_URL을 jdbc:postgresql://db:5432/<DB_NAME>로 덮어쓴다.

# Database
DB_URL=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# JWT
JWT_SECRET=
JWT_EXPIRATION_SECONDS=

# OpenAI
OPENAI_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kakao OAuth
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_ADMIN_KEY=

# Frontend (Vite)
VITE_GOOGLE_CLIENT_ID=
VITE_KAKAO_REST_API_KEY=
